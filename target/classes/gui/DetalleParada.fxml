<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 20 0 0 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, -5, 0);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: #eb8e83; -fx-background-radius: 20 0 0 0;">
                    <children>
                        <Label text="DETALLES DE PARADA" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Nombre de la Parada:" textFill="#666666">
                                    <font>
                                        <Font name="HelveticaLTStd-Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtNombreDetalle" promptText="Ej: Estación Central" style="-fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
                           <font>
                              <Font name="HelveticaLTStd-Roman" size="12.0" />
                           </font></TextField>
                            </children>
                        </VBox>

                        <Label text="Conexiones actuales:" textFill="#666666">
                            <font>
                                <Font name="HelveticaLTStd-Bold" size="12.0" />
                            </font>
                        </Label>

                        <ScrollPane fitToWidth="true" prefHeight="200.0" style="-fx-background-color: transparent; -fx-background: white;">
                            <content>
                                <VBox fx:id="vboxRutasDetalle" prefHeight="196.0" prefWidth="257.0" spacing="10.0" style="-fx-background-color: white;" />
                            </content>
                        </ScrollPane>
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </VBox>

                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="btnEditar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #eb8e83; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="EDITAR">
                            <font>
                                <Font name="HelveticaLTStd-Bold" size="13.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="ELIMINAR">
                            <font>
                                <Font name="HelveticaLTStd-Bold" size="13.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnCerrarDetalle" mnemonicParsing="false" style="-fx-background-color: #999999; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="✕">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
